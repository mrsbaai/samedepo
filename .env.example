APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_APPEARANCE=dark

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_CONNECTION=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Reverb powers real-time features (e.g. instant support ticket messages)
# via WebSockets. Generate real values with `php artisan reverb:install`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log

# Blockchain HD wallet configuration: per-network account-level extended public keys (xpub).
# These are used to derive customer deposit addresses only; private keys never touch the app.
BLOCKCHAIN_BITCOIN_XPUB=
BLOCKCHAIN_USDT_TRC20_XPUB=
BLOCKCHAIN_USDT_ERC20_XPUB=

# Blockchain provider API credentials for deposit detection and confirmation tracking.
# Leave blank to disable detection for that network.
BLOCKCYPHER_TOKEN=
BLOCKCYPHER_NETWORK=main
TRONGRID_API_KEY=
TRONGRID_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
INFURA_PROJECT_ID=
INFURA_PROJECT_SECRET=
INFURA_NETWORK=mainnet
INFURA_USDT_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ForgeOS production infrastructure — per-project; keep in sync with .devin/mcp_config.json
RESEND_API_KEY=
CLOUDFLARE_API_TOKEN=

SERVER_HOST=
SERVER_USER=
SERVER_PORT=22
SERVER_SSH_KEY_PATH=
SERVER_SUDO_PASSWORD=

# Brand identity — used automatically by emails, UI, and marketing materials.
# Leave these commented to use the ForgeOS defaults; the `plan`/`setup` phases
# can populate them from the .project/00-input/ package.
# BRAND_NAME="${APP_NAME}"
# BRAND_TAGLINE=
# BRAND_LOGO_URL=
# BRAND_LOGO_ALT=
# BRAND_LOGO_WIDTH_PX=150
# BRAND_COLOR_PRIMARY="#2563eb"
# BRAND_COLOR_SECONDARY="#64748b"
# BRAND_COLOR_ACCENT="#f59e0b"
# BRAND_COLOR_BACKGROUND="#f8fafc"
# BRAND_COLOR_SURFACE="#ffffff"
# BRAND_COLOR_TEXT="#1e293b"
# BRAND_COLOR_MUTED="#64748b"
# BRAND_COLOR_ERROR="#dc2626"
# BRAND_COLOR_SUCCESS="#16a34a"
# BRAND_FONT_HEADING="system-ui, -apple-system, BlinkMacSystemFont, sans-serif"
# BRAND_FONT_BODY="system-ui, -apple-system, BlinkMacSystemFont, sans-serif"
# BRAND_SUPPORT_EMAIL="${MAIL_FROM_ADDRESS}"
# BRAND_WEBSITE_URL="${APP_URL}"

# Support ticket agent name — displayed as "{name} from Support" next to
# admin replies (leave unset to just show "Support"). Changing this only
# affects new messages; past messages keep the name that was set when they
# were sent.
# SUPPORT_AGENT_NAME="Robert"

# Open support tickets with no activity for this many days are automatically
# closed and the ticket owner is emailed.
# SUPPORT_AUTO_CLOSE_AFTER_DAYS=7

# OpenRouter API key and model for AI-generated support replies.
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Umani (Lilstat) analytics — set your website ID to enable tracking.
# Get your ID at https://lilstat.com
# UMANI_WEBSITE_ID=
