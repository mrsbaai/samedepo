[Unit]
Description=samedepo self-custody signing service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/samedepo-signer
EnvironmentFile=/etc/samedepo-signer/signer.env
ExecStart=/opt/samedepo-signer/venv/bin/python /opt/samedepo-signer/wsgi.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
